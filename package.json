{
  "name": "@kensaurus/cursor-kenji",
  "version": "1.40.0",
  "description": "158 Cursor AI agent skills, 63 slash commands, 6 subagents, and MCP configs for React/Next.js/Supabase development.",
  "type": "module",
  "bin": {
    "cursor-kenji": "bin/cursor-kenji.js"
  },
  "scripts": {
    "install:cursor": "node bin/install.mjs",
    "install:auto": "node bin/install.mjs --auto",
    "install:claude": "node bin/install.mjs --claude",
    "install:codex": "node bin/install.mjs --codex",
    "install:gemini": "node bin/install.mjs --gemini",
    "install:all": "node bin/install.mjs --all",
    "install:cursor:clean": "node bin/install.mjs --clean",
    "install:cursor:dry": "node bin/install.mjs --dry-run",
    "verify:install": "node bin/install.mjs --verify",
    "install:cursor:clean:dry": "node bin/install.mjs --clean --dry-run",
    "install:cursor:link": "node bin/install.mjs --link",
    "install:cursor:restore": "node bin/install.mjs --restore",
    "check:skills": "node scripts/check-skill-count.mjs",
    "fix:skills": "node scripts/check-skill-count.mjs --fix",
    "gen:skill-index": "node scripts/generate-skill-index.mjs --write",
    "check:skill-index": "node scripts/generate-skill-index.mjs --check",
    "validate:skills": "node scripts/validate-skills.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs --self-test",
    "check:mcp-pins": "node scripts/check-mcp-pins.mjs",
    "check:skill-refs": "node scripts/check-skill-refs.mjs --self-test && node scripts/check-skill-refs.mjs",
    "check:docs-facts": "node scripts/check-docs-facts.mjs",
    "check:md-structure": "node scripts/check-md-structure.mjs --self-test && node scripts/check-md-structure.mjs",
    "check:dead-code": "npx -y knip@6.36.0 --max-issues 0 --treat-config-hints-as-errors",
    "check:dead-code:prod": "npx -y knip@6.36.0 --production --max-issues 0",
    "test:install": "node scripts/test-install.mjs",
    "test:completion-gate": "node scripts/test-completion-gate.mjs",
    "test": "node scripts/validate-skills.mjs && node scripts/check-skill-count.mjs && node scripts/generate-skill-index.mjs --check && node scripts/scan-secrets.mjs --self-test && node scripts/check-mcp-pins.mjs && node scripts/check-docs-facts.mjs && node scripts/check-skill-refs.mjs --self-test && node scripts/check-skill-refs.mjs && node scripts/check-md-structure.mjs --self-test && node scripts/check-md-structure.mjs && node scripts/test-completion-gate.mjs && node scripts/test-install.mjs && npm run -s check:dead-code && npm run -s check:dead-code:prod"
  },
  "keywords": [
    "cursor",
    "cursor-ai",
    "cursor-skills",
    "agent-skills",
    "ai-agents",
    "llm-tools",
    "claude",
    "claude-code",
    "skills-sh",
    "mcp",
    "nextjs",
    "supabase"
  ],
  "files": [
    "skills/",
    "skills-cursor/",
    "commands/",
    "commands-portable/",
    "agents/",
    "rules/",
    "hooks/",
    "mcp/",
    "install.sh",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "llms.txt",
    "docs/screenshots/",
    "SECURITY.md",
    "assets/",
    "skills.sh.json",
    ".cursor-plugin/",
    ".claude-plugin/",
    ".mcp.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensaurus/cursor-kenji.git"
  },
  "homepage": "https://www.skills.sh/kensaurus/cursor-kenji",
  "bugs": {
    "url": "https://github.com/kensaurus/cursor-kenji/issues"
  },
  "author": "kensaurus",
  "license": "MIT"
}
