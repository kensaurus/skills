{
  "name": "@kensaurus/skills",
  "version": "2.5.0",
  "description": "You say the job; the playbook runs. 161 agent skills, 63 slash commands, 6 subagents, and MCP templates for Claude Code, Cursor, Codex CLI, and Gemini CLI. Each playbook asks first, tests first, and proves the result. Tuned for React, Next.js, and Supabase. Works on most stacks.",
  "type": "module",
  "bin": {
    "kenji": "bin/kenji.js"
  },
  "scripts": {
    "install:cursor": "node bin/install.mjs",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "install:auto": "node bin/install.mjs --auto",
    "install:claude": "node bin/install.mjs --claude",
    "install:codex": "node bin/install.mjs --codex",
    "install:gemini": "node bin/install.mjs --gemini",
    "install:all": "node bin/install.mjs --all",
    "install:cursor:clean": "node bin/install.mjs --clean",
    "install:cursor:dry": "node bin/install.mjs --dry-run",
    "verify:install": "node bin/install.mjs --verify",
    "install:cursor:clean:dry": "node bin/install.mjs --clean --dry-run",
    "install:cursor:link": "node bin/install.mjs --link",
    "install:cursor:restore": "node bin/install.mjs --restore",
    "check:skills": "node scripts/check-skill-count.mjs",
    "fix:skills": "node scripts/check-skill-count.mjs --fix",
    "gen:skill-index": "node scripts/generate-skill-index.mjs --write",
    "check:skill-index": "node scripts/generate-skill-index.mjs --check",
    "validate:skills": "node scripts/validate-skills.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs --self-test",
    "check:mcp-pins": "node scripts/check-mcp-pins.mjs",
    "check:skill-refs": "node scripts/check-skill-refs.mjs --self-test && node scripts/check-skill-refs.mjs",
    "check:docs-facts": "node scripts/check-docs-facts.mjs",
    "check:md-structure": "node scripts/check-md-structure.mjs --self-test && node scripts/check-md-structure.mjs",
    "check:dead-code": "npx -y knip@6.38.0 --max-issues 0 --treat-config-hints-as-errors",
    "check:dead-code:prod": "npx -y knip@6.38.0 --production --max-issues 0",
    "test:install": "node scripts/test-install.mjs",
    "test:completion-gate": "node scripts/test-completion-gate.mjs",
    "test": "node scripts/validate-skills.mjs && node scripts/check-skill-count.mjs && node scripts/generate-skill-index.mjs --check && node scripts/scan-secrets.mjs --self-test && node scripts/check-mcp-pins.mjs && node scripts/check-docs-facts.mjs && node scripts/check-skill-refs.mjs --self-test && node scripts/check-skill-refs.mjs && node scripts/check-md-structure.mjs --self-test && node scripts/check-md-structure.mjs && node scripts/shorten-skill-descriptions.mjs --self-test && node scripts/test-completion-gate.mjs && node scripts/test-install.mjs && npm run -s check:dead-code && npm run -s check:dead-code:prod"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "claude-code-plugin",
    "claude-skills",
    "cursor",
    "cursor-skills",
    "codex",
    "codex-cli",
    "gemini-cli",
    "skills-sh",
    "slash-commands",
    "subagents",
    "coding-agent",
    "agent-workflows",
    "playbooks",
    "skill-pack",
    "mcp",
    "nextjs",
    "supabase",
    "react",
    "typescript",
    "ai-agents",
    "llm-tools",
    "vibe-coding"
  ],
  "files": [
    "skills/",
    "skills-cursor/",
    "commands/",
    "commands-portable/",
    "agents/",
    "rules/",
    "hooks/",
    "mcp/",
    "install.sh",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE",
    "llms.txt",
    "SECURITY.md",
    "skills.sh.json",
    ".cursor-plugin/",
    ".claude-plugin/",
    ".mcp.json",
    "assets/logo.png",
    "assets/logo.svg"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensaurus/skills.git"
  },
  "homepage": "https://github.com/kensaurus/skills#readme",
  "bugs": {
    "url": "https://github.com/kensaurus/skills/issues"
  },
  "author": "kensaurus",
  "license": "MIT"
}
